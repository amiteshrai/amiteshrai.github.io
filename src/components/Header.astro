---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const isActive = (href: string) => {
  const base = href.split('#')[0];
  return base !== '/' ? path.startsWith(base) : path === '/';
};
---

<header class="border-b border-border">
  <div class="mx-auto flex w-full max-w-4xl items-center justify-between px-5 py-4">
    <a href="/" class="flex items-center gap-2 font-mono text-base font-semibold tracking-tight text-fg">
      <Logo class="h-[1.05em] w-[1.05em]" />
      amitesh rai
    </a>
    <nav class="flex items-center gap-4">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['text-sm', isActive(l.href) ? 'text-fg' : 'text-muted hover:text-fg']}
          >
            {l.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

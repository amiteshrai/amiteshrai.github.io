---
const pillars = [
  {
    title: 'Data Platforms',
    desc: 'When the auditor asks where a number came from, you get an answer, not a meeting. Snowflake, dbt, medallion, audit spines - every output traceable to its source.',
    proof: 'Competitive pricing intel / ~4M scrapes per week',
  },
  {
    title: 'MLOps & Forecasting',
    desc: 'New markets are a config change, not a code branch - and the forecasts hold, because leakage is prevented by design.',
    proof: 'Demand forecasting / 4 markets x 3 metrics',
  },
  {
    title: 'Agentic AI',
    desc: 'You get agents in production, not another demo that dies in the deck. LangGraph, Claude, RAG, MCP.',
    proof: 'Sales intelligence agent / built & shipped solo',
  },
];
---

<section id="work" class="scroll-mt-20 border-t border-border py-10">
  <p class="mb-6 font-mono text-xs uppercase tracking-[0.14em] text-muted">What I build - one proof each</p>
  <div class="grid gap-4 sm:grid-cols-3">
    {
      pillars.map((p) => (
        <div class="flex h-full flex-col rounded-xl border border-border bg-card p-5">
          <h3 class="font-serif text-base font-semibold">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{p.desc}</p>
          <p class="mt-auto pt-4 font-mono text-xs text-accent">{p.proof}</p>
        </div>
      ))
    }
  </div>
</section>

---
const pillars = [
  {
    title: 'Data Platforms',
    desc: 'Pricing decisions ran on numbers no one could trace. I built a platform with lineage on every metric - so the calls hold up in the boardroom and under audit.',
    proof: 'Competitive pricing intel / ~4M scrapes per week',
  },
  {
    title: 'MLOps & Forecasting',
    desc: 'Every new market meant a forecasting rebuild and a fresh leakage risk. I made expansion a config change with leakage engineered out - so forecasts hold as you scale.',
    proof: 'Demand forecasting / 4 markets x 3 metrics',
  },
  {
    title: 'Agentic AI',
    desc: 'Most AI agents impress in a demo and die before production. I built a sales-intelligence agent hardened to run for real - solo, start to finish.',
    proof: 'Sales intelligence agent / built & shipped solo',
  },
];
---

<section id="work" class="scroll-mt-20 border-t border-border py-10">
  <p class="mb-6 font-mono text-xs uppercase tracking-[0.14em] text-muted">The work - one proof each</p>
  <div class="grid gap-4 sm:grid-cols-3">
    {
      pillars.map((p) => (
        <div class="flex h-full flex-col rounded-xl border border-border bg-card p-5">
          <h3 class="font-serif text-base font-semibold">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{p.desc}</p>
          <p class="mt-auto pt-4 font-mono text-xs text-accent">{p.proof}</p>
        </div>
      ))
    }
  </div>
</section>

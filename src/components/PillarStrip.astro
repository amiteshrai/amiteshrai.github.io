---
const pillars = [
  {
    title: 'Data Platforms',
    desc: 'When an auditor asks where a number came from, you get an answer, not a meeting. Snowflake, dbt, medallion - every output traced to its source.',
    proof: 'Competitive pricing intel / ~4M scrapes per week',
  },
  {
    title: 'MLOps & Forecasting',
    desc: 'You expand into a new market with a config change, not a code branch. The forecasts hold because leakage is designed out from the start.',
    proof: 'Demand forecasting / 4 markets x 3 metrics',
  },
  {
    title: 'Agentic AI',
    desc: 'You get agents that earn their keep in production, not another demo that dies in the deck. Built on LangGraph, Claude, RAG, and MCP.',
    proof: 'Sales intelligence agent / built & shipped solo',
  },
];
---

<section id="work" class="scroll-mt-20 border-t border-border py-10">
  <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">The work - one proof each</p>
  <p class="mb-6 mt-2 max-w-[46ch] text-sm text-muted">No client logos. Just the work, and the numbers it moved.</p>
  <div class="grid gap-4 sm:grid-cols-3">
    {
      pillars.map((p) => (
        <div class="flex h-full flex-col rounded-xl border border-border bg-card p-5">
          <h3 class="font-serif text-base font-semibold">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{p.desc}</p>
          <p class="mt-auto pt-4 font-mono text-xs text-accent">{p.proof}</p>
        </div>
      ))
    }
  </div>
</section>

---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, summary, tags } = post.data;
const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="border-b border-border py-6">
  <h2 class="font-serif text-xl font-semibold tracking-tight">
    <a href={`/posts/${post.id}`} class="hover:text-accent">{title}</a>
  </h2>
  <p class="mt-1 font-mono text-xs text-muted">
    <time datetime={date.toISOString()}>{dateStr}</time>
  </p>
  {summary && <p class="mt-2 text-muted">{summary}</p>}
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2 font-mono text-xs">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="text-accent hover:underline">#{tag}</a>
        ))}
      </div>
    )
  }
</article>

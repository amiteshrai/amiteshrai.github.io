---
import { Icon } from 'astro-icon/components';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  title="Toggle light/dark"
  class="rounded-md border border-border p-1.5 text-fg hover:bg-card"
>
  {/* Moon: shown in light mode (click -> dark) */}
  <Icon name="lucide:moon" class="block h-4 w-4 dark:hidden" />
  {/* Sun: shown in dark mode (click -> light) */}
  <Icon name="lucide:sun" class="hidden h-4 w-4 dark:block" />
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  })();
</script>

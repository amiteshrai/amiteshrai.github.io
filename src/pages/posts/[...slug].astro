---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

// One static page per post. Param key `slug` must match the [...slug] filename;
// we bind it to the Content Layer entry `id` (replaces the removed `entry.slug`).
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
// `render(post)` replaces the removed `post.render()` method (Astro 6).
const { Content, headings } = await render(post);
---

<PostLayout frontmatter={post.data} headings={headings}>
  <Content />
</PostLayout>

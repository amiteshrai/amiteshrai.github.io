---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    role: 'Associate Program Manager - Data & Analytics CoE',
    org: 'Global data & AI consultancy',
    when: 'Sep 2025 - Present',
    note: 'Lead data & AI engineering across 3 concurrent enterprise clients. Own SOW delivery, architecture, hiring, and proposals, including the technical narrative for a $3.5M RFP win. Shipped a Snowflake competitive pricing intelligence platform, an MLOps demand forecasting platform, and an agentic sales intelligence product built solo.',
  },
  {
    role: 'Engineering Manager',
    org: 'US car wash network (400+ locations)',
    when: 'Mar 2023 - Aug 2025',
    note: 'Built the data platform from greenfield: medallion pipelines, models, monitoring, and reporting. Same Store Sales automation cut manual effort 85%. Designed a computer vision system for license plate recognition and customer tracking.',
  },
  {
    role: 'Senior Data Engineer',
    org: 'Crypto trading platform',
    when: 'Mar 2022 - Feb 2023',
    note: 'Built the foundational warehouse: on-chain and off-chain integration, anomaly detection for fraud and wash trade monitoring, and ML fraud models (TensorFlow, graph neural networks).',
  },
  {
    role: 'Associate Technical Architect',
    org: 'Global retail analytics firm',
    when: 'Jul 2015 - Mar 2022',
    note: 'Seven years architecting retail analytics and pricing intelligence platforms for global enterprise clients. Delivered $500K+ in annual client cost savings; cut SKU rationalization turnaround 70% with a top tier strategy consultancy.',
  },
  {
    role: 'Lead Consultant (Platform, Architecture & AI)',
    org: 'Digital pathology startup',
    when: 'Jun 2022 - Jul 2024',
    note: 'Built a clinical grade digital pathology platform from first commit to production. Architected 15+ PyTorch models reaching >90% accuracy across hospital trials in three countries. Led a team of 4.',
  },
];

const principles = [
  {
    title: 'Simplicity, earned',
    desc: 'I map the full complexity before cutting to the simplest design that survives it. Clever is a liability; clear is what lasts.',
  },
  {
    title: 'One source of truth',
    desc: 'Every fact lives in exactly one place, held there by structure rather than convention, so two copies can never drift apart and start disagreeing.',
  },
  {
    title: 'Validate at the boundary',
    desc: 'Bad input fails fast where it enters; the core trusts its data instead of second-guessing it three layers down.',
  },
  {
    title: 'Lineage by default',
    desc: 'Every metric traces back to its source, so a number can answer for itself instead of shrugging.',
  },
  {
    title: 'Config over rewrite',
    desc: 'Behavior lives in configuration, not hardcoded branches, so a new market or metric is a config change, not a re-engineering project.',
  },
  {
    title: 'Safe to retry',
    desc: 'Idempotent operations and recoverable pipelines, so a 2am failure is a re-run, not an incident.',
  },
];

const skills = [
  { group: 'Agentic & LLMs', items: 'LangGraph, LangChain, Anthropic Claude, LangSmith, ChromaDB, RAG, MCP' },
  { group: 'ML & Forecasting', items: 'scikit-learn, XGBoost, LightGBM, Prophet, PyTorch, Hyperparameter Optimization, MLflow' },
  { group: 'Data & Analytics', items: 'Snowflake, dbt, Airflow, Databricks, Spark, Delta Lake, Medallion' },
  { group: 'Full Stack', items: 'Python, TypeScript, React, FastAPI, Node.js, Tailwind, Playwright' },
  { group: 'Infrastructure', items: 'AWS, GCP, Docker, Cloud Run, NGINX, Jenkins, GitHub Actions, PostgreSQL, Redis' },
  { group: 'Consulting & Delivery', items: 'SOW & engagement delivery, Solution architecture, Proposals & RFPs, Technical hiring, Team building & mentoring' },
];
---

<BaseLayout title="About - Amitesh Rai" description="10+ years building data & AI platforms that drive revenue and hold up under scrutiny.">
  <section class="py-8">
    <span class="block h-[3px] w-11 bg-accent"></span>
    <h1 class="mt-4 font-serif text-4xl font-bold tracking-tight">About</h1>
    <div class="post-body mt-5">
      <p>
        For 10+ years I've built data and AI platforms - the kind that work at scale and stay
        trustworthy under operator and auditor pressure. I architect the systems, run the teams
        that keep them alive, and write production code, often in the same week.
      </p>
      <p>
        Speed is the easy part. The work I'm proudest of is the kind you can <em>question</em> and
        it answers back: ask why a number came out the way it did, and there's a clear answer rather
        than a shrug. That sounds dull right up until it's late, someone important wants the figure,
        and the system can actually show its work. That's the part I care about.
      </p>
    </div>
  </section>

  <section class="border-t border-border py-8">
    <p class="mb-3 font-mono text-xs uppercase tracking-[0.14em] text-muted">How I design systems</p>
    <p class="mb-6 text-base leading-relaxed text-muted">
      I model systems around the business domain, not the database schema. Boundaries land where the
      domain has real seams, so each part owns one capability, changes for one reason, and meets the
      rest through explicit contracts instead of reaching across them. A thin core orchestrates; the
      focused modules do the work.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        principles.map((p) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <h3 class="font-serif text-base font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-border py-8">
    <p class="mb-6 font-mono text-xs uppercase tracking-[0.14em] text-muted">Experience</p>
    <div class="flex flex-col gap-6">
      {
        experience.map((e) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-serif text-lg font-semibold">
                {e.role} <span class="text-muted">/ {e.org}</span>
              </h3>
              <span class="font-mono text-xs text-muted">{e.when}</span>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-muted">{e.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-border py-8">
    <p class="mb-6 font-mono text-xs uppercase tracking-[0.14em] text-muted">Skills</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        skills.map((s) => (
          <div class="rounded-xl border border-border bg-card p-4">
            <p class="font-serif text-sm font-semibold">{s.group}</p>
            <p class="mt-1 text-sm text-muted">{s.items}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-border py-8">
    <p class="text-lg leading-relaxed text-fg">
      Open to senior roles and select consulting in data, analytics, and AI.
    </p>
    <div class="mt-4 flex flex-wrap gap-4 font-mono text-sm">
      <a class="text-accent hover:underline" href="mailto:amiteshrai@outlook.com">email</a>
      <a class="text-accent hover:underline" href="https://linkedin.com/in/amiteshkumarrai">linkedin</a>
      <a class="text-accent hover:underline" href="https://github.com/amiteshrai">github</a>
    </div>
  </section>
</BaseLayout>

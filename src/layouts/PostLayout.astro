---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';

interface PostLink {
  slug: string;
  title: string;
}

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    category: string;
    tags: string[];
    summary: string;
  };
  headings: MarkdownHeading[];
  newer?: PostLink | null;
  older?: PostLink | null;
}

const { frontmatter, headings, newer = null, older = null } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const dateStr = frontmatter.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={frontmatter.title} description={frontmatter.summary}>
  <article class="py-6">
    <header class="mb-8 border-b border-border pb-6">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent">{frontmatter.category}</p>
      <h1 class="mt-2 font-serif text-3xl font-bold tracking-tight">{frontmatter.title}</h1>
      <p class="mt-2 font-mono text-xs text-muted">
        <time datetime={frontmatter.date.toISOString()}>{dateStr}</time>
        {
          frontmatter.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="ml-3 text-accent hover:underline">#{tag}</a>
          ))
        }
      </p>
    </header>

    {
      toc.length > 0 && (
        <nav class="mb-8 rounded-lg border border-border bg-card p-4 text-sm">
          <p class="mb-2 font-mono text-xs uppercase tracking-[0.14em] text-muted">On this page</p>
          <ul class="space-y-1">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-muted hover:text-accent">{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="post-body">
      <slot />
    </div>

    {
      (older || newer) && (
        <nav class="mt-12 flex items-stretch justify-between gap-4 border-t border-border pt-6">
          <div class="min-w-0 flex-1">
            {older && (
              <a href={`/posts/${older.slug}`} class="group block">
                <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Previous</p>
                <p class="mt-1 font-serif text-base text-fg group-hover:text-accent">{older.title}</p>
              </a>
            )}
          </div>
          <div class="min-w-0 flex-1 text-right">
            {newer && (
              <a href={`/posts/${newer.slug}`} class="group block">
                <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Next</p>
                <p class="mt-1 font-serif text-base text-fg group-hover:text-accent">{newer.title}</p>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</BaseLayout>
